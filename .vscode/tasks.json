{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: compilar",
      "type": "cmake",
      "command": "build",
      "targets": ["all"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "CMake: pruebas",
      "type": "cmake",
      "command": "test",
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "Formatear código",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/format.ps1",
      "problemMatcher": []
    },
    {
      "label": "Preparar vcpkg",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap.ps1",
      "problemMatcher": []
    }
  ]
}
